---
import Layout from '../layouts/Layout.astro';
import { companies } from '../data/companies';

/** Enough cards that one loop is wider than a wide screen, so the seamless wrap never shows a gap. */
const MIN_CARDS_PER_LOOP = 10;
const SECONDS_PER_CARD = 4;

const loop = Array.from(
  { length: Math.ceil(MIN_CARDS_PER_LOOP / companies.length) },
  () => companies,
).flat();
const duration = `${loop.length * SECONDS_PER_CARD}s`;
---

<Layout
  title="Be om innsyn etter avslag på jobbsøknad"
  description="Finn riktig personvernadresse og be arbeidsgiveren om innsyn i hvordan søknaden din ble behandlet."
>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Fått avslag på en jobbsøknad?</h1>
    <p class="lede">
      Du har rett til å <mark>se hva arbeidsgiveren vet om deg</mark> — og få vite om det var en maskin som
      sa nei. Vi finner riktig adresse og skriver kravet for deg.
    </p>
    <a class="button" href="/firma/">Finn arbeidsgiveren din <span aria-hidden="true">→</span></a>
  </section>

  <!-- Decorative: keyboard and screen reader users reach every company through /firma/ -->
  <div class="marquee" aria-hidden="true" style={`--marquee-duration: ${duration}`}>
    <div class="marquee-track">
      {
        [0, 1].map(() =>
          loop.map((company) => (
            <a class="marquee-card" href={`/firma/${company.slug}/`} tabindex="-1">
              <span class="marquee-brand">{company.brands[0]}</span>
              <span class="marquee-controller">{company.controller.name}</span>
            </a>
          )),
        )
      }
    </div>
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 44rem;
    padding-block: var(--space-6) var(--space-7);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .lede mark {
    color: var(--ink);
  }

  .marquee {
    overflow: hidden;
    margin-inline: calc(var(--gutter) * -1);
    padding-block: var(--space-2) var(--space-4);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: var(--space-3);
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-card {
    display: grid;
    gap: var(--space-1);
    width: 14rem;
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 150ms var(--ease-out);
  }

  .marquee-card:hover {
    border-color: var(--ink);
  }

  .marquee-brand {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .marquee-controller {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  /* The track holds two identical halves; shifting by one half (plus half a gap) loops seamlessly. */
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - var(--space-3) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }

    .marquee-card {
      transition: none;
    }
  }
</style>
