---
import Layout from '../layouts/Layout.astro';
import { companies } from '../data/companies';
---

<Layout
  title="Be om innsyn etter avslag på jobbsøknad"
  description="Finn riktig personvernadresse og be arbeidsgiveren om innsyn i hvordan søknaden din ble behandlet."
>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Fått avslag på en jobbsøknad?</h1>
    <p class="lede">
      Du har rett til å <mark>se hva arbeidsgiveren vet om deg</mark> — og få vite om det var en maskin som
      sa nei. Vi finner riktig adresse og skriver kravet for deg.
    </p>
  </section>

  <section class="companies" aria-labelledby="companies-title">
    <h2 id="companies-title">Hvor søkte du?</h2>
    <ul>
      {
        companies.map((company) => (
          <li>
            <a href={`/firma/${company.slug}/`}>
              <span class="company-brand">{company.brands.join(' / ')}</span>
              <span class="company-controller">{company.controller.name}</span>
              <span class="company-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="missing">
      Listen er under arbeid — flere arbeidsgivere kommer.
    </p>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    max-width: 44rem;
    padding-block: var(--space-6) var(--space-7);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .lede mark {
    color: var(--ink);
  }

  .companies {
    display: grid;
    gap: var(--space-5);
  }

  .companies ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }

  .companies a {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }

  .companies a:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  .company-brand {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .company-controller {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .company-arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    font-size: var(--text-lg);
  }

  .missing {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .companies a {
      transition: none;
    }
  }
</style>
