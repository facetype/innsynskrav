---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { atsNames, companies, type Company } from '../../data/companies';
import { formatDate, formatOrgNr } from '../../lib/format';
import RequestForm from '../../components/RequestForm';
import { buildCorrectionHref } from '../../lib/contact';

export const getStaticPaths = (() =>
  companies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }))) satisfies GetStaticPaths;

interface Props {
  company: Company;
}

const { company } = Astro.props;
const brand = company.brands[0];
const companyAtsNames = [...new Set(company.senders.map((sender) => atsNames[sender.ats]))];
const atsList = companyAtsNames.join(' / ');
---

<Layout
  title={`Slik ber du om innsyn hos ${brand}`}
  description={`Riktig personvernadresse for innsynskrav hos ${brand} (${company.controller.name}).`}
>
  <nav aria-label="Brødsmuler" class="crumbs">
    <a href="/firma/">← Alle arbeidsgivere</a>
  </nav>

  <header class="title">
    <h1>Innsynskrav til {brand}</h1>
    <div class="recipient">
      <p class="recipient-label">Sendes til</p>
      <p class="recipient-email mono">{company.privacyEmail}</p>
      <p class="recipient-verified">
        <span class="check" aria-hidden="true">✓</span>{' '}
        Kontrollert {formatDate(company.lastVerified)} mot{' '}
        <a href={company.privacyPolicyUrl}>personvernerklæringen</a>
      </p>
      <p class="recipient-report">
        <a href={buildCorrectionHref(brand, company.privacyEmail)}>Feil adresse? Si fra</a>
      </p>
    </div>
    {
      atsList && (
        <p class="warning">
          <mark>Ikke svar på avslaget.</mark> Det kom via {atsList} og når ikke frem til personvernombudet.
        </p>
      )
    }
  </header>

  <section id="krav" class="request-section" aria-labelledby="krav-title">
    <h2 id="krav-title" class="visually-hidden">Lag innsynskravet</h2>
    <RequestForm
      client:load
      company={{ brand, recipient: company.privacyEmail, atsNames: companyAtsNames }}
    />
  </section>

  <section class="after" aria-labelledby="after-title">
    <h2 id="after-title">Hva skjer etterpå?</h2>
    <p>
      De har én måned på å svare. Hører du ingenting, kan du purre — og deretter klage til Datatilsynet.
    </p>
  </section>

  <details class="controller">
    <summary>Om behandlingsansvarlig</summary>
    <dl>
      <dt>Navn</dt>
      <dd>{company.controller.name}</dd>
      <dt>Org.nr.</dt>
      <dd class="mono">{formatOrgNr(company.controller.orgNr)}</dd>
      <dt>Adresse</dt>
      <dd>{company.controller.address}</dd>
    </dl>
  </details>
</Layout>

<style>
  .crumbs a {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .title {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--space-5) var(--space-6);
  }

  .recipient {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    max-width: 100%;
  }

  .recipient-label {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .recipient-email {
    font-size: clamp(1.0625rem, 3.5vw, 1.375rem);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .recipient-verified {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .recipient-report {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .check {
    color: var(--ok);
    font-weight: 700;
  }

  .warning {
    max-width: var(--measure);
  }

  .after {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-block: var(--space-7) var(--space-5);
  }

  .after h2 {
    font-size: var(--text-lg);
  }

  .after p {
    color: var(--ink-muted);
  }

  .controller {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .controller summary {
    cursor: pointer;
  }

  .controller dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
  }

  .controller dd {
    margin: 0;
    color: var(--ink);
  }
</style>
